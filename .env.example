# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PrivateEmail Mail Server Configuration (mail.privateemail.com)
# Incoming IMAP: mail.privateemail.com : 993 (SSL) / POP3: 995 (SSL)
# Outgoing SMTP: mail.privateemail.com : 465 (SSL) or 587 (TLS)
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="help@doctorbabamukisa.com"
SMTP_PASS="YOUR_PRIVATEEMAIL_PASSWORD"
NOTIFICATION_EMAIL="help@doctorbabamukisa.com"
